  <name>Meandris Write</name>
  <summary>Lightweight text and Markdown editor</summary>
  <developer id="io.github.onckelinx">
    <name>Rik Onckelinx - meandris.ai</name>
  </developer>

  <description>
    <p>
      A very small, fast, native text and Markdown editor with a live preview. It opens
      instantly, keeps your files exactly as they were, and shows Markdown as source,
      rendered, or side by side.
    </p>
    <ul>
      <li>Tabs, find, word wrap, printing and PDF export</li>
      <li>Markdown in Source, Split and Preview views</li>
      <li>Paste as Markdown turns text copied from a web page or chatbot into Markdown</li>
      <li>Reloads files that change on disk and never loses unsaved work silently</li>
    </ul>
  </description>

  <launchable type="desktop-id">meandriswrite.desktop</launchable>
  <url type="homepage">https://github.com/onckelinx/meandriswrite</url>
